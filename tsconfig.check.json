{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      /**
       * `@/*` üç uygulamada da tanımlı ama farklı köklere işaret ediyor.
       * Dizi olarak vermek doğru sonucu üretiyor: TypeScript sırayla deniyor
       * ve dosya kümeleri ayrık olduğu için ilk eşleşen doğru olan.
       *
       * Bunu eklemeden `dependency-cruiser` uygulama içi kenarları hiç
       * görmüyordu — grafik yalnız `@yonetim/*` importlarından oluşuyordu ve
       * orphan tespiti tamamen yanlış çalışıyordu.
       */
      "@/*": ["./apps/app/src/*", "./apps/api/src/*", "./apps/worker/src/*"],
      "@api/*": ["./apps/api/src/*"],
      "@yonetim/config": ["./packages/config/src/index.ts"],
      "@yonetim/core": ["./packages/core/src/index.ts"],
      "@yonetim/core/crypto": ["./packages/core/src/crypto.ts"],
      "@yonetim/db": ["./packages/db/src/index.ts"],
      "@yonetim/auth": ["./packages/auth/src/index.ts"],
      "@yonetim/auth/guard": ["./packages/auth/src/guard.ts"],
      "@yonetim/auth/cookie": ["./packages/auth/src/cookie.ts"],
      "@yonetim/auth/rate-limit": ["./packages/auth/src/rate-limit.ts"],
      "@yonetim/dues": ["./packages/dues/src/index.ts"],
      "@yonetim/pricing": ["./packages/pricing/src/index.ts"],
      "@yonetim/campaigns": ["./packages/campaigns/src/index.ts"],
      "@yonetim/kvkk": ["./packages/kvkk/src/index.ts"],
      "@yonetim/whatsapp": ["./packages/whatsapp/src/index.ts"],
      "@yonetim/sms": ["./packages/sms/src/index.ts"],
      "@yonetim/emails": ["./packages/emails/src/index.ts"],
      "@yonetim/notifications": ["./packages/notifications/src/index.ts"],
      "@yonetim/payment": ["./packages/payment/src/index.ts"],
      "@yonetim/bank": ["./packages/bank/src/index.ts"],
      "@yonetim/seo": ["./packages/seo/src/index.ts"],
      "@yonetim/jobs": ["./packages/jobs/src/index.ts"],
      "@yonetim/i18n": ["./packages/i18n/src/index.ts"],
      "@yonetim/ui": ["./packages/ui/src/index.ts"],
      "@yonetim/contracts": ["./packages/contracts/src/index.ts"],
      "@yonetim/contracts/shared": ["./packages/contracts/src/_shared/index.ts"]
    },
    "baseUrl": "."
  },
  // Testlerin `.tsx` olanları da dahil: erişilebilirlik smoke testi bileşen
  // render ediyor ve JSX yazıyor. Yalnız `.ts` kapsanınca o dosya tip
  // kontrolünden sessizce kaçıyordu — test de kodun bir parçası.
  //
  // DİKKAT: burada blok yorumu (slash-yıldız) KULLANMAYIN. Aşağıdaki glob
  // desenleri yıldız-slash dizisi içeriyor ve blok yorumunu erken kapatıyor;
  // sonuç sessiz ama yıkıcı: `include` anahtarı okunamıyor, TypeScript
  // varsayılan `**/*` desenine düşüp `apps/api`yi de derliyor ve NestJS
  // dekoratörleri yüzünden ~600 sahte hata üretiyor.
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
