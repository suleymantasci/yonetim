# Caddy — TLS sonlandırma ve yönlendirme (MIMARI-PLAN §11).
#
# Yönlendirme kararı: `/v1/*` ve `/api/v1/*` doğrudan api'ye çıkıyor (muhasebe
# yazılımı ve mobil oradan geliyor), panelin geri kalanı app'e. Panelin **iç**
# çağrıları (`/v1/panel/*`) buradan geçmiyor — onlar docker iç ağında
# `http://api:3000` üzerinden gidiyor, TLS ve RTT maliyeti yok (§9.2b).
#
# `/api/v1/*` adresi A5'te Next'ten api'ye taşındı ama **adres değişmedi**:
# o yüzeyin istemcileri bizim repomuzda değil ve URL'in kendisi sözleşmenin
# parçası (§9.1). Taşımanın dışarıdan görünmemesi tam olarak amaç.

{
	email {$ACME_EMAIL:admin@localhost}
}

# --- Pazarlama sitesi ---------------------------------------------------------
{$SITE_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy web:3000
}

# --- Panel + sakin portalı + dış API -----------------------------------------
{$APP_DOMAIN:panel.localhost} {
	encode zstd gzip

	# Dış sözleşme yüzeyi — donuk, sürümlü (§9.1).
	handle /v1/* {
		reverse_proxy api:3000
	}

	# Aynı yüzeyin eski (ve yayınlanmış) adresi. Next'te artık karşılığı yok.
	handle /api/v1* {
		reverse_proxy api:3000
	}

	# Sağlık probu dışarıya açılmaz; yalnız iç ağdan.
	handle /health* {
		respond 404
	}

	handle {
		reverse_proxy app:3001
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
