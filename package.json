{
  "name": "site-yonetim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:up": "pnpm db:up && turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:runtime": "node tests/runtime-redis-csrf-smoke.mjs",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @yonetim/db db:generate",
    "db:migrate": "pnpm --filter @yonetim/db db:migrate",
    "db:migrate:as-admin": "node scripts/migrate-as-admin.mjs",
    "db:seed": "pnpm --filter @yonetim/db db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "setup": "pnpm install && pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "arch": "depcruise --config .dependency-cruiser.cjs apps/api/src apps/app/src apps/worker/src packages",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps/api/src apps/app/src apps/worker/src packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axe-core": "^4.12.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=5 <6": "^5.0.12",
      "fast-uri@>=3 <4": "^3.1.8",
      "js-yaml@>=4 <5": "^4.3.2",
      "js-yaml@>=5 <6": "^5.4.2",
      "multer@>=2 <3": "^2.4.0",
      "nanoid@>=3 <4": "^3.3.19",
      "postcss@>=8 <9": "^8.5.28",
      "sharp": "^0.35.5",
      "undici@>=8 <9": "^8.11.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
